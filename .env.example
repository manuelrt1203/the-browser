# API TMDB ; valeur secrète côté serveur uniquement.
TMDB_READ_TOKEN=

# Canal @TheBrowser365, ID issu de l’export, à confirmer avec getChat.
TELEGRAM_CHANNEL_ID=-1004339801492
# Canal privé Premium : identifiant distinct, à renseigner après création.
TELEGRAM_PREMIUM_CHANNEL_ID=
# Secret aléatoire, identique au secret_token du webhook Telegram.
TELEGRAM_WEBHOOK_SECRET=
# Utilisé uniquement par le script d’enregistrement, pas par le frontend.
TELEGRAM_BOT_TOKEN=
SITE_URL=https://the-browser-one.vercel.app

# Vercel : connecter Upstash Redis depuis Marketplace/Storage.
# Variables KV_* injectées par l’intégration, ou UPSTASH_REDIS_REST_URL/TOKEN.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Développement local seulement. Jamais utilisé comme stockage sur Vercel.
CATALOGUE_DATA_DIR=

# Simulation Premium : développement local uniquement, aucun débit ni accès réel.
# Ignoré en production, même si activé.
PREMIUM_DEMO_ENABLED=0

# Stripe : renseigner uniquement dans le stockage sécurisé, jamais dans Git.
# Clé de test restreinte (rk_test_) recommandée avec les permissions nécessaires.
STRIPE_SECRET_KEY_TEST=
# Secret de signature local au serveur (à configurer lors du raccordement webhook).
STRIPE_WEBHOOK_SECRET=
# Pilote Stripe : local ou prévisualisation explicite, désactivé en production.
STRIPE_TEST_CHECKOUT_ENABLED=0

# Connexion Telegram Premium : activer après configuration Redis et mise à jour
# additive des types de notifications du webhook existant, sans changer son URL.
PREMIUM_TELEGRAM_AUTH_ENABLED=0
# Séparation des sessions/commandes de test et réelles.
PREMIUM_ENVIRONMENT=test

# SasPay : local ou prévisualisation explicite. Clé SANDBOX/PAYIN sk_test_ requise.
# Une clé sk_live_ n'est jamais acceptée par ce parcours.
SASPAY_TEST_ENABLED=0
SASPAY_API_KEY_TEST=
# Secret de signature brut pour HMAC local, distinct de la clé API.
# Configurer dans les variables serveur sécurisées, sans substitution par proxy.
SASPAY_WEBHOOK_SECRET=
