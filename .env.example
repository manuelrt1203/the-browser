# API TMDB ; valeur secrète côté serveur uniquement.
TMDB_READ_TOKEN=

# Canal @TheBrowser365, ID issu de l’export, à confirmer avec getChat.
TELEGRAM_CHANNEL_ID=-1004339801492
# Secret aléatoire, identique au secret_token du webhook Telegram.
TELEGRAM_WEBHOOK_SECRET=
# Utilisé uniquement par le script d’enregistrement, pas par le frontend.
TELEGRAM_BOT_TOKEN=
SITE_URL=https://the-browser-one.vercel.app

# Vercel : connecter Upstash Redis depuis Marketplace/Storage.
# Variables KV_* injectées par l’intégration, ou UPSTASH_REDIS_REST_URL/TOKEN.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Développement local seulement. Jamais utilisé comme stockage sur Vercel.
CATALOGUE_DATA_DIR=
